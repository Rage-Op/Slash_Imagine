# MongoDB connection string
MONGO_URL=mongodb://localhost:27017/slash_imagine

# Server port and host
PORT=3001
HOST=127.0.0.1

# JWT secret key - use a strong random string in production
JWT_SECRET=your-secret-key-here

# Admin user credentials
# NOTE: These are only used when seeding the initial admin user.
# If an admin with ADMIN_USERNAME already exists, these values are ignored.
# To change admin credentials after initial creation, update them in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPassword123!
ADMIN_EMAIL=admin@example.com
